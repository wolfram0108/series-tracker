# Папка виртуального окружения
venv/
.venv/

# Кэш Python
__pycache__/
*.pyc

# Файлы с переменными окружения
.env

# Папки от IDE (на всякий случай)
.idea/
.vscode/

# База данных SQLite (включая WAL/SHM и любые бэкапы рядом с app.db)
*.db
app.db*
*.bak

# Папка тестов
test/
# Папка с торрентами
parser_dumps/
# Папка кодом страниц для дебага
torrent_cache/
debug_kinozal.py
vk_scraper_dumps/
logs/

# Telethon session (фаза 0, scripts/telegram_phase0)
scripts/telegram_phase0/*.session
scripts/telegram_phase0/*.session-journal
# Артефакты новой системы
.venv*/
logs/
tests/fixtures/

# Локальные секреты — никогда не синхронизировать
docs/key.txt

# Лог запуска стенда (создаётся restart.sh)
uvicorn.log

# Генерируемый граф знаний (инструмент разбора, не исходник)
graphify-out/
# Raw site answers of mission stages carry signed stream links and player tokens.
docs/missions/voice-alignment/stage-10/raw/*
!docs/missions/voice-alignment/stage-10/raw/MANIFEST.md

# Raw answers of real services (collectors): not for a public repository
data/

# Backups of the working data taken before a migration or a risky change
backups/

# Local agent settings and keys
/.claude/

# The native core is built on the server from git (native/build.sh), as web/dist is
/native/target/
/core/_native*.so
