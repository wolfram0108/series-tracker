  "DownloadFrame": {
   "description": "One line of the stream of a download. `progress` carries the telemetry `figures` (contracts/provider_socket.md, section\n7); `done` the height of the picture of the file that lies at the path; `error` the reason and its `kind`: `final` is the last\nword of the source (asking again changes nothing), `broken` a way that broke (the tracker asks again, and the failure is the\nsource's when its attempts are spent), `unasked` a failure that says nothing of the source (the provider did not reach it).",
   "properties": {
    "figures": {
     "additionalProperties": true,
     "title": "Figures",
     "type": "object"
    },
    "height": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Height"
    },
    "kind": {
     "default": "broken",
     "enum": [
      "final",
      "broken",
      "unasked"
     ],
     "title": "Kind",
     "type": "string"
    },
    "reason": {
     "default": "",
     "title": "Reason",
     "type": "string"
    },
    "type": {
     "enum": [
      "progress",
      "alive",
      "done",
      "error"
     ],
     "title": "Type",
     "type": "string"
    }
   },
   "required": [
    "type"
   ],
   "title": "DownloadFrame",
   "type": "object"
  },
  "DownloadRequest": {
   "description": "`POST /v1/download`: the file of the link of a row into `path` (absolute; the tracker and the provider share the\npaths). The number of connections and the way the file comes are the provider's own business.",
   "properties": {
    "max_height": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Max Height"
    },
    "path": {
     "title": "Path",
     "type": "string"
    },
    "term_hours": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Term Hours"
    },
    "url": {
     "title": "Url",
     "type": "string"
    }
   },
   "required": [
    "url",
    "path"
   ],
   "title": "DownloadRequest",
   "type": "object"
  },
  "FeedEvent": {
   "description": "`hello` and `changed` of the feed: the revision of the manifest the provider has now.",
   "properties": {
    "revision": {
     "title": "Revision",
     "type": "string"
    }
   },
   "required": [
    "revision"
   ],
   "title": "FeedEvent",
   "type": "object"
  },
  "Manifest": {
   "$defs": {
    "ManifestFamily": {
     "properties": {
      "label": {
       "default": "",
       "title": "Label",
       "type": "string"
      },
      "name": {
       "minLength": 1,
       "title": "Name",
       "type": "string"
      },
      "owns": {
       "title": "Owns",
       "type": "string"
      },
      "video": {
       "title": "Video",
       "type": "string"
      }
     },
     "required": [
      "name",
      "owns",
      "video"
     ],
     "title": "ManifestFamily",
     "type": "object"
    },
    "ManifestPlace": {
     "properties": {
      "label": {
       "default": "",
       "title": "Label",
       "type": "string"
      },
      "name": {
       "title": "Name",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "title": "ManifestPlace",
     "type": "object"
    },
    "ManifestPlayer": {
     "properties": {
      "kind": {
       "default": "line",
