       "items": {
        "$ref": "#/$defs/ManifestPlace"
       },
       "title": "Places",
       "type": "array"
      }
     },
     "required": [
      "name"
     ],
     "title": "ManifestPlayer",
     "type": "object"
    },
    "ManifestSearch": {
     "properties": {
      "label": {
       "default": "",
