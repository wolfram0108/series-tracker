   "title": "Manifest",
   "type": "object"
  },
  "ReadFrame": {
   "description": "One line of the stream of a read. `draft` is a `TableDraft` as the dict it serialises to.",
   "properties": {
    "current": {
     "default": 0,
     "title": "Current",
     "type": "integer"
    },
    "draft": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Draft"
    },
    "phase": {
     "default": "",
     "title": "Phase",
     "type": "string"
    },
    "reason": {
     "default": "",
     "title": "Reason",
     "type": "string"
    },
    "total": {
     "default": 0,
     "title": "Total",
     "type": "integer"
    },
    "type": {
     "enum": [
      "progress",
      "alive",
      "draft",
      "error"
     ],
     "title": "Type",
     "type": "string"
    }
   },
   "required": [
    "type"
   ],
   "title": "ReadFrame",
   "type": "object"
  },
  "ReadRequest": {
   "description": "`POST /v1/read`: the whole page into one table. `last_rows` are `TableRow` dicts of the last complete table.",
   "properties": {
    "fresh": {
     "default": false,
     "title": "Fresh",
     "type": "boolean"
    },
    "last_rows": {
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "title": "Last Rows",
     "type": "array"
    },
    "off": {
     "items": {
      "type": "string"
     },
     "title": "Off",
     "type": "array"
    },
    "recent": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Recent"
    },
    "rows": {
     "default": "all",
     "title": "Rows",
     "type": "string"
    },
    "term_hours": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Term Hours"
    },
    "url": {
     "title": "Url",
     "type": "string"
    }
   },
   "required": [
    "url"
   ],
   "title": "ReadRequest",
   "type": "object"
  },
  "TableDraft": {
   "$defs": {
    "RowState": {
     "description": "`not_obtained` is not `absent`: the answer stayed unsure to the end, the player may still have the video.",
     "enum": [
      "playable",
      "absent",
      "not_obtained"
     ],
     "title": "RowState",
     "type": "string"
    },
    "RowTrack": {
     "description": "What a row carries: a video with its sound, or a sound track (every row of a site), or a subtitles track of a torrent\nrelease (stage 15, DESIGN.md 7.1.1). The kind of the voice-over a player names is no such mark: a «subtitles»\ntranslation of Kodik is a video with its sound.",
     "enum": [
      "sound",
      "subtitles"
     ],
     "title": "RowTrack",
     "type": "string"
    },
    "RowVoice": {
     "description": "The voice-over as the player or the site words it; `kind` is the type the player names (voice, subtitles, ...).",
     "properties": {
      "kind": {
       "default": "",
       "title": "Kind",
       "type": "string"
      },
      "name": {
       "default": "",
       "title": "Name",
       "type": "string"
      }
     },
     "title": "RowVoice",
     "type": "object"
    },
    "TableRow": {
     "additionalProperties": false,
     "description": "One element of one player's list, as the site gave it.",
     "properties": {
      "duration_s": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Duration S"
      },
      "group": {
       "default": "",
       "title": "Group",
       "type": "string"
      },
      "heights": {
       "items": {
        "type": "integer"
       },
       "title": "Heights",
       "type": "array"
      },
      "key": {
       "title": "Key",
       "type": "string"
      },
      "language": {
       "default": "",
       "title": "Language",
       "type": "string"
      },
      "link": {
       "default": "",
       "title": "Link",
       "type": "string"
      },
      "part": {
       "default": "",
       "title": "Part",
       "type": "string"
      },
      "player": {
       "title": "Player",
       "type": "string"
      },
      "player_label": {
       "default": "",
       "title": "Player Label",
       "type": "string"
      },
      "published": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Published"
      },
      "reason": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Reason"
      },
      "site_fields": {
       "additionalProperties": true,
       "title": "Site Fields",
       "type": "object"
      },
      "state": {
       "$ref": "#/$defs/RowState"
      },
      "subtitle_type": {
       "default": "",
       "enum": [
        "",
        "full",
        "signs"
       ],
       "title": "Subtitle Type",
       "type": "string"
      },
      "text": {
       "default": "",
       "title": "Text",
       "type": "string"
      },
      "timeline": {
       "default": "",
       "title": "Timeline",
       "type": "string"
      },
      "track": {
       "$ref": "#/$defs/RowTrack",
       "default": "sound"
      },
      "video": {
       "default": "",
       "title": "Video",
       "type": "string"
      },
      "voice": {
       "$ref": "#/$defs/RowVoice"
      }
     },
     "required": [
      "key",
      "player",
      "state"
     ],
     "title": "TableRow",
     "type": "object"
    },
    "UnreadPart": {
     "additionalProperties": false,
     "description": "A part of a page the read could not get: its rows are the ones it gave the last read that got it, if any.\n`names` are what the site calls its content (the voice-overs of a catalog, the title of an episode).",
     "properties": {
      "names": {
       "items": {
        "type": "string"
       },
       "title": "Names",
       "type": "array"
      },
      "part": {
       "title": "Part",
       "type": "string"
      },
      "player_label": {
       "default": "",
       "title": "Player Label",
       "type": "string"
      },
      "reason": {
       "title": "Reason",
       "type": "string"
      }
     },
     "required": [
      "part",
      "reason"
     ],
     "title": "UnreadPart",
     "type": "object"
    }
   },
   "additionalProperties": false,
   "description": "What a site returns: the head, the rows and the parts of the page it could not read (`UnreadPart`; the core keeps\ntheir rows of the read before). Row keys are unique within the page (the core rejects a repeat).",
   "properties": {
    "channel": {
     "default": "",
     "title": "Channel",
     "type": "string"
    },
    "names": {
     "items": {
      "type": "string"
     },
     "title": "Names",
     "type": "array"
    },
    "rows": {
     "items": {
      "$ref": "#/$defs/TableRow"
     },
     "title": "Rows",
     "type": "array"
    },
    "site_voice": {
     "default": "",
     "title": "Site Voice",
     "type": "string"
    },
    "title": {
     "default": "",
     "title": "Title",
     "type": "string"
    },
    "unread": {
     "items": {
      "$ref": "#/$defs/UnreadPart"
     },
     "title": "Unread",
     "type": "array"
    }
   },
   "title": "TableDraft",
   "type": "object"
  },
