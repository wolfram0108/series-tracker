{
 "messages": {
  "AppSearchReply": {
   "$defs": {
    "AppCard": {
     "description": "A card of a title as the search of its application gives it; `url` is the address it is a source by (empty when\nthe application gave the card no number to be asked by again).",
     "properties": {
      "app": {
       "title": "App",
       "type": "string"
      },
      "area": {
       "default": "",
       "title": "Area",
       "type": "string"
      },
      "blurb": {
       "default": "",
       "title": "Blurb",
       "type": "string"
      },
      "genres": {
       "default": "",
       "title": "Genres",
       "type": "string"
      },
      "id": {
       "title": "Id",
       "type": "string"
      },
      "name": {
       "default": "",
       "title": "Name",
       "type": "string"
      },
      "pic": {
       "default": "",
       "title": "Pic",
       "type": "string"
      },
      "remarks": {
       "default": "",
       "title": "Remarks",
       "type": "string"
      },
      "sub": {
       "default": "",
       "title": "Sub",
       "type": "string"
      },
      "url": {
       "title": "Url",
       "type": "string"
      },
      "year": {
       "default": "",
       "title": "Year",
       "type": "string"
      }
     },
     "required": [
      "app",
      "id",
      "url"
     ],
     "title": "AppCard",
     "type": "object"
    },
    "AppResults": {
     "description": "One application's answer to the search: a page of its cards, or the reason it gave none.",
     "properties": {
      "app": {
       "title": "App",
       "type": "string"
      },
      "cards": {
       "items": {
        "$ref": "#/$defs/AppCard"
       },
       "title": "Cards",
       "type": "array"
      },
      "label": {
       "title": "Label",
       "type": "string"
      },
      "page": {
       "default": 1,
       "title": "Page",
       "type": "integer"
      },
      "pages": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Pages"
      },
      "reason": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Reason"
      },
      "total": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Total"
      }
     },
     "required": [
      "app",
      "label"
     ],
     "title": "AppResults",
     "type": "object"
    }
   },
   "properties": {
    "apps": {
     "items": {
      "$ref": "#/$defs/AppResults"
     },
     "title": "Apps",
     "type": "array"
    }
   },
   "title": "AppSearchReply",
   "type": "object"
  },
  "AppSearchRequest": {
   "properties": {
    "app": {
     "default": "",
     "title": "App",
     "type": "string"
    },
    "page": {
     "default": 1,
     "minimum": 1,
     "title": "Page",
     "type": "integer"
    },
    "query": {
     "title": "Query",
     "type": "string"
    }
   },
   "required": [
    "query"
   ],
   "title": "AppSearchRequest",
   "type": "object"
  },
  "DownloadFrame": {
   "description": "One line of the stream of a download. `progress` carries the telemetry `figures` (contracts/provider_socket.md, section\n7); `done` the height of the picture of the file that lies at the path; `error` the reason and its `kind`: `final` is the last\nword of the source (asking again changes nothing), `broken` a way that broke (the tracker asks again, and the failure is the\nsource's when its attempts are spent), `unasked` a failure that says nothing of the source (the provider did not reach it).",
   "properties": {
    "figures": {
     "additionalProperties": true,
     "title": "Figures",
     "type": "object"
    },
    "height": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Height"
    },
    "kind": {
     "default": "broken",
     "enum": [
      "final",
      "broken",
      "unasked"
     ],
     "title": "Kind",
     "type": "string"
    },
    "reason": {
     "default": "",
     "title": "Reason",
     "type": "string"
    },
    "type": {
     "enum": [
      "progress",
      "alive",
      "done",
      "error"
     ],
     "title": "Type",
     "type": "string"
    }
   },
   "required": [
    "type"
   ],
   "title": "DownloadFrame",
   "type": "object"
  },
  "DownloadRequest": {
   "description": "`POST /v1/download`: the file of the link of a row into `path` (absolute; the tracker and the provider share the\npaths). The number of connections and the way the file comes are the provider's own business.",
   "properties": {
    "max_height": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Max Height"
    },
    "path": {
     "title": "Path",
     "type": "string"
    },
    "term_hours": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Term Hours"
    },
    "url": {
     "title": "Url",
     "type": "string"
    }
   },
   "required": [
    "url",
    "path"
   ],
   "title": "DownloadRequest",
   "type": "object"
  },
  "FeedEvent": {
   "description": "`hello` and `changed` of the feed: the revision of the manifest the provider has now.",
   "properties": {
    "revision": {
     "title": "Revision",
     "type": "string"
    }
   },
   "required": [
    "revision"
   ],
   "title": "FeedEvent",
   "type": "object"
  },
  "Manifest": {
   "$defs": {
    "ManifestFamily": {
     "properties": {
      "label": {
       "default": "",
       "title": "Label",
       "type": "string"
      },
      "name": {
       "minLength": 1,
       "title": "Name",
       "type": "string"
      },
      "owns": {
       "title": "Owns",
       "type": "string"
      },
      "video": {
       "title": "Video",
       "type": "string"
      }
     },
     "required": [
      "name",
      "owns",
      "video"
     ],
     "title": "ManifestFamily",
     "type": "object"
    },
    "ManifestPlace": {
     "properties": {
      "label": {
       "default": "",
       "title": "Label",
       "type": "string"
      },
      "name": {
       "title": "Name",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "title": "ManifestPlace",
     "type": "object"
    },
    "ManifestPlayer": {
     "properties": {
      "kind": {
       "default": "line",
