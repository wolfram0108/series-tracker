       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "title": "ProviderInfo",
     "type": "object"
    },
    "SiteAddress": {
     "description": "How an address of a site is told and written: its schemes, a path matching `path` whole, and the one canonical\nspelling (`{group}` of `path`).",
     "properties": {
      "canonical": {
       "title": "Canonical",
       "type": "string"
      },
      "path": {
       "title": "Path",
       "type": "string"
      },
      "schemes": {
       "items": {
        "type": "string"
       },
       "minItems": 1,
       "title": "Schemes",
       "type": "array"
      }
     },
     "required": [
      "schemes",
      "path",
      "canonical"
     ],
     "title": "SiteAddress",
     "type": "object"
    }
   },
