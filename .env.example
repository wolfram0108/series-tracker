# Конфигурация запуска стенда. Скопировать в .env и заполнить реальными
# значениями. .env в git НЕ коммитится (см. .gitignore) — секреты живут
# только локально на машине развёртывания.

# Alignment daemon of the voice-overs, track-muxer: the default until an address is saved in the settings
# (empty and nothing saved — the conform module stays idle)
ST_CONFORM_URL=

# qBittorrent (без ST_QBIT_URL модуль torrents не стартует)
ST_QBIT_URL=http://127.0.0.1:8080
ST_QBIT_USER=admin
ST_QBIT_PASS=

# Вход в веб-интерфейс (docs/security.md, Этап 1) — ОБЯЗАТЕЛЬНО:
# ключ подписи сессионной куки (длинная случайная строка; без него
# сессии слетают при рестарте). Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
ST_SECRET_KEY=
# Первичная учётка администратора (создаётся при первом старте, если
# учётки ещё нет). Пароль в БД хранится только хэшем.
ST_ADMIN_USER=admin
ST_ADMIN_PASSWORD=
# Secure-куки: true (по умолчанию) — кука только по https (за nginx с TLS).
# Для входа по http локально, до настройки nginx, временно: false.
# ST_COOKIE_SECURE=true
# Замок (требовать вход): true по умолчанию. Держать false, пока фронт не
# умеет логиниться (иначе текущий UI получит 401); включить вместе с
# готовым экраном входа. См. docs/security.md, Этап 1.
# ST_AUTH_REQUIRED=true

# Шифрование секретов в БД (Этап 3Б) — ОБЯЗАТЕЛЬНО для прода: стабильный
# ключ Fernet (при его смене секреты не расшифруются). Без него ключ
# выводится из ST_SECRET_KEY (тогда ротация ST_SECRET_KEY ломает секреты).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ST_ENCRYPTION_KEY=
# /docs и /openapi.json (по умолчанию выключены в проде — Этап 4).
# Включить для генерации типов фронта (gen:api):
# ST_DOCS_ENABLED=true

# Reverse-proxy (Этап 2): за nginx с TLS.
# ST_FORWARDED_IPS — адрес nginx, которому доверяем X-Forwarded-* (иначе
# приложение не узнает, что соединение https → Secure-куки не отдаются).
# ST_FORWARDED_IPS=192.168.3.47
# ST_ALLOWED_HOSTS — разрешённые Host (домен + loopback), защита от
# host-header атак. Пусто — проверки нет.
# ST_ALLOWED_HOSTS=setr.mywolfram.ru,localhost,127.0.0.1

# Необязательное:
# ST_DB_PATH=app.db   # по умолчанию app.db в каталоге проекта
# ST_LOG_DIR=logs   # папка журналов сервиса; start.sh задаёт logs/ проекта, процесс без неё пишет в stderr

# Видеоприложения, читаемые через их API (modules/sources/apps): JSON-профиль клиента на приложение.
# Значения закрытые; без переменной приложение не читается. Форма:
# `player_agent` — агент, с которым плеер самого приложения просит его потоки (часть CDN других не пускает);
# заголовок, данный приложением вместе с потоком, важнее. Без ключа потоки просятся с заголовками приложения.
# ST_APP_BANRI='{"label":"半日","latin":"Banri","protocol":"app99","host":"…","versionName":"…","name":"…","package":"…","buildNumber":"…","buildSignature":"…","uuid":"…","player_agent":"okhttp/3.14.9"}'
# ST_APP_YUNDUO='{"label":"布布","latin":"YunDuo","protocol":"yunduo","host":"…","id":"…","dev":"…","sk":"…","web_sign":"…","x_client":"…","ua":"…"}'
# ST_APP_APPMN='{"label":"米诺","latin":"AppMN","protocol":"appmn","host":"…","client_pub":"…","device_id":"…","version":"…","device_brand":"…","device_manufacturer":"…","device_model":"…","sig_src":"…","so_version":"…"}'
# Alloha: профиль клиента из эталонного запуска штатного плеера — fingerprint из Borth (64 hex) и его User-Agent (Chrome).
# ST_ALLOHA_FINGERPRINT=…
# ST_ALLOHA_USER_AGENT='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/…'
