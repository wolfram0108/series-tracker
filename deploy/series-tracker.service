# systemd-юнит прода. Установка:
#   sudo cp deploy/series-tracker.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now series-tracker
# Под другого пользователя/путь — поправить User/Group/WorkingDirectory/ExecStart.
# Подробности — docs/deployment.md.
[Unit]
Description=Series Tracker v2 — uvicorn :5000
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=exec
User=user
Group=user
WorkingDirectory=/home/user/series-tracker
ExecStart=/home/user/series-tracker/start.sh
Restart=always
RestartSec=3
# The service puts each program it starts (ffmpeg, ffprobe, yt-dlp) into a group of its own with a limit of memory
# (core/proc.py isolate): a program killed for memory is the failure of its step, not the end of the service.
Delegate=memory pids
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
